{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Article cache hit ratio",
      "id": 1,
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "targets": [{"expr": "100 * sum(article_cache_requests_total{result=\"hit\"}) / clamp_min(sum(article_cache_requests_total), 1)", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Comment cache hit ratio",
      "id": 2,
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "targets": [{"expr": "100 * sum(comment_cache_requests_total{result=\"hit\"}) / clamp_min(sum(comment_cache_requests_total), 1)", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Articles in warm cache",
      "id": 3,
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "article_cache_items", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Comment groups in LRU cache",
      "id": 4,
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "comment_cache_groups", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Article cache HIT vs MISS",
      "id": 5,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "article_cache_requests_total", "legendFormat": "{{result}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Comment cache HIT vs MISS",
      "id": 6,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "comment_cache_requests_total", "legendFormat": "{{result}}", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Comment LRU evictions",
      "id": 7,
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "comment_cache_evictions_total", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Comment invalidations",
      "id": 8,
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "comment_cache_invalidations_total", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Article refresh errors",
      "id": 9,
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(article_cache_refresh_total{result=\"error\"})", "refId": "A"}]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["cache", "HappyHeadlines"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "HappyHeadlines Cache Monitoring",
  "uid": "happyheadlines-cache",
  "version": 1
}
